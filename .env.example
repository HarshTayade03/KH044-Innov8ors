# VulnTriager — Environment Configuration
# Copy this file to .env and fill in values before running the application.
# NEVER commit .env to git. Only .env.example is committed.

# ─── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to repo root or absolute)
DATABASE_PATH=./vulntriager.db

# ─── Sandbox / PoC Validation ─────────────────────────────────────────────────
# Set to true ONLY in a controlled lab environment with Docker available.
# Default is false — uses the lab simulator (safe, offline, deterministic).
SANDBOX_ENABLED=false

# Comma-separated list of hostnames the sandbox is allowed to target.
# Only used when SANDBOX_ENABLED=true.
SANDBOX_ALLOWLIST=app.example.test,target.lab

# Maximum seconds allowed for any single sandbox execution.
SANDBOX_TIMEOUT_SECONDS=30

# ─── Embedding Model ─────────────────────────────────────────────────────────
# SentenceTransformer model name. Must be downloadable via sentence-transformers.
# all-MiniLM-L6-v2 is fast, offline, 384-dimensional. Do not change mid-sprint.
MODEL_NAME=all-MiniLM-L6-v2

# ─── CISA Known Exploited Vulnerabilities (KEV) ───────────────────────────────
# Set KEV_LIVE=true to fetch the KEV catalog from CISA on startup (requires internet).
# Set KEV_LIVE=false to use the local mock file (recommended for offline demo).
KEV_LIVE=false
KEV_DATA_PATH=./data/cisa_kev_mock.json

# ─── EPSS (Exploit Prediction Scoring System) ─────────────────────────────────
# Set EPSS_LIVE=true to call the live FIRST.org EPSS API (requires internet).
# Set EPSS_LIVE=false to use the local mock file (recommended for offline demo).
EPSS_LIVE=false
EPSS_DATA_PATH=./data/epss_mock.json
EPSS_API_URL=https://api.first.org/data/v1/epss

# ─── Risk Score Weights ───────────────────────────────────────────────────────
# These six weights MUST sum to exactly 1.0.
# The application will refuse to start if they don't.
# Formula: R = 100 * (CVSS*w1 + EPSS*w2 + KEV*w3 + Asset*w4 + Exposure*w5 + Validation*w6)
RISK_WEIGHT_CVSS=0.25
RISK_WEIGHT_EPSS=0.20
RISK_WEIGHT_KEV=0.15
RISK_WEIGHT_ASSET=0.15
RISK_WEIGHT_EXPOSURE=0.15
RISK_WEIGHT_VALIDATION=0.10

# ─── Future Scope (Stubs — leave empty for prototype) ─────────────────────────
# Slack incoming webhook URL for Immediate-tier case notifications.
SLACK_WEBHOOK_URL=

# Jira base URL and API token for auto-creating tickets on case approval.
JIRA_URL=
JIRA_API_TOKEN=
